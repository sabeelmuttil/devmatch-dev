# daily.dev Personal Access Token (Plus) — https://app.daily.dev/settings/api
DAILY_DEV_PAT=

# Google Gemini API key — create at https://aistudio.google.com/apikey
# If you see "denied access" or 403, create a NEW key (no quotes/spaces around value)
GEMINI_API_KEY=

# Optional: preferred Gemini model (default tries gemini-2.5-flash, then fallbacks)
# GEMINI_MODEL=gemini-2.5-flash

# Production site URL (required on Vercel for X share card image links)
# Example: https://dailydevmatch.dev or https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=

# Short share links on Vercel — add Upstash Redis from Vercel Marketplace (Storage → Redis).
# Vercel auto-sets UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN on Production.
# Without Redis, share URLs use a long embedded token (~400+ chars).